generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uid              String    @id
  email            String    @unique
  passwordHash     String?
  displayName      String
  role             String    @default("engineer")
  employeeId       String?
  phoneNumber      String?
  specialty        String?
  projects         Project[]   @relation("ProjectUsers")
  specialtiesRef   Specialty[] @relation("UserSpecialties")
  supervisedTechnicians Technician[] @relation("SupervisorTechnicians")
  assignedTickets  Ticket[]    @relation("TicketAssignedSupervisor")
  photoURL         String?
  profileCompleted Boolean   @default(false)
  disabled         Boolean   @default(false)
  notifPrefs       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}


model Project {
  id            String     @id @default(cuid())
  name          String
  location      String
  abbreviation  String
  users         User[]     @relation("ProjectUsers")
  technicians   Technician[]
  tickets       Ticket[]
  createdAt     DateTime   @default(now())
  clients       Client[]
}

model Client {
  id                 String    @id @default(cuid())
  projectId          String
  name               String
  phone              String
  villaNumber        String
  blockNumber        String?
  handoverDate       String?
  warrantyExpiryDate String?
  createdAt          DateTime  @default(now())
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets            Ticket[]
}

model Ticket {
  id                     String    @id @default(cuid())
  ticketId               String    @unique
  refNumber              String
  projectAbbr            String?
  projectId              String
  clientId               String
  clientName             String
  villaNumber            String
  issuedAt               String?
  description            String
  type                   String
  typeId                 String?
  status                 String    @default("open")
  priority               Int       @default(4)
  assigneeName           String?
  assignedSupervisorId   String?
  assignedSupervisor     User?     @relation("TicketAssignedSupervisor", fields: [assignedSupervisorId], references: [uid])
  assignedSupervisorIds  String[]  @default([])
  assignedSupervisors    Json?
  detectedTypes          String[]  @default([])
  appointmentTime        String?
  appointmentNotes       String?
  closureNotes           String?
  maintenanceItems       Json?
  createdAt              DateTime  @default(now())
  closedAt               DateTime?
  createdBy              String?
  client                 Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  ticketType             TicketType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
}

model Technician {
  id              String    @id @default(cuid())
  employeeId      String?   @unique
  phoneNumber     String?   @unique
  name            String
  specialty       String?
  experienceLevel String?
  supervisorId    String?
  supervisor      User?     @relation("SupervisorTechnicians", fields: [supervisorId], references: [uid])
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  idNumber        String?
  idPhotoUrl      String?
  documentUrls    String[]  @default([])
  clothingSize    String?
  shoeSize        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum TicketStatus {
  open
  in_progress
  pending
  completed
  closed
  waiting
  out_of_scope
}

enum TicketPriority {
  low
  medium
  medium_high
  high
  urgent
}

// ══════════════════════════════════════════════════════════════════════════════
//  جداول التصنيف والتعلم
// ══════════════════════════════════════════════════════════════════════════════

model Specialty {
  id        String             @id @default(cuid())
  key       String             @unique
  nameAr    String
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())

  users            User[]          @relation("UserSpecialties")
  ticketTypes      TicketType[]
  ticketSubTypes   TicketSubType[]
}

model TicketType {
  id          String             @id @default(cuid())
  key         String             @unique
  nameAr      String
  description String?
  specialtyId String?
  specialty   Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  keywords  TicketTypeKeyword[]
  subTypes  TicketSubType[]
  tickets   Ticket[]
}

model TicketSubType {
  id            String             @id @default(cuid())
  nameAr        String
  description   String?
  parentTypeId  String
  parentType    TicketType         @relation(fields: [parentTypeId], references: [id], onDelete: Cascade)
  specialtyId   String?
  specialty     Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  keywords TicketTypeKeyword[]
}

model TicketTypeKeyword {
  id          String        @id @default(cuid())
  keyword     String
  typeId      String?
  ticketType  TicketType?   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  subTypeId   String?
  subType     TicketSubType? @relation(fields: [subTypeId], references: [id], onDelete: Cascade)
  weight      Float         @default(1.0)
  isLearned   Boolean       @default(false)
  usageCount  Int           @default(0)
  confidence  Float         @default(1.0)
  source      String        @default("seed")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([keyword, typeId])
  @@unique([keyword, subTypeId])
  @@index([keyword])
  @@index([typeId])
  @@index([subTypeId])
}
