generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uid                   String       @id
  email                 String       @unique
  passwordHash          String?
  displayName           String
  role                  String       @default("engineer")
  employeeId            String?
  phoneNumber           String?
  specialty             String?
  photoURL              String?
  profileCompleted      Boolean      @default(false)
  disabled              Boolean      @default(false)
  notifPrefs            Json?
  onLeave               Boolean      @default(false)
  substituteUid         String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  supervisedTechnicians Technician[] @relation("SupervisorTechnicians")
  assignedTickets       Ticket[]     @relation("TicketAssignedSupervisor")
  projects              Project[]    @relation("ProjectUsers")
  specialtiesRef        Specialty[]  @relation("UserSpecialties")
  substitute            User?        @relation("UserSubstitute", fields: [substituteUid], references: [uid])
  substituteFor         User[]       @relation("UserSubstitute")
}

model Project {
  id           String       @id @default(cuid())
  name         String
  location     String
  abbreviation String
  createdAt    DateTime     @default(now())
  clients      Client[]
  technicians  Technician[]
  tickets      Ticket[]
  users        User[]       @relation("ProjectUsers")
}

model Client {
  id                 String   @id @default(cuid())
  projectId          String
  name               String
  phone              String
  villaNumber        String
  blockNumber        String?
  handoverDate       String?
  warrantyExpiryDate String?
  createdAt          DateTime @default(now())
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets            Ticket[]
}

model Ticket {
  id                    String         @id @default(cuid())
  ticketId              String         @unique
  refNumber             String
  projectAbbr           String?
  projectId             String
  clientId              String?
  clientName            String
  villaNumber           String
  issuedAt              String?
  description           String
  type                  String
  typeId                String?
  status                TicketStatus   @default(open)
  priority              Int            @default(4)
  assigneeName          String?
  assignedSupervisorId  String?
  assignedSupervisorIds String[]       @default([])
  assignedSupervisors   Json?
  detectedTypes         String[]       @default([])
  appointmentTime       String?
  appointmentNotes      String?
  appointmentAwaitingReply Boolean @default(false)
  closureNotes          String?
  maintenanceItems      Json?
  createdAt             DateTime       @default(now())
  closedAt              DateTime?
  createdBy             String?
  geminiClassifiedAt    DateTime?
  approvalSentAt        DateTime?
  approvalState         String?
  approvalUserId        String?
  clientApproved        Boolean?
  clientApprovedAt      DateTime?
  clientRating          Int?
  subTypeId             String?
  assignedSupervisor    User?          @relation("TicketAssignedSupervisor", fields: [assignedSupervisorId], references: [uid])
  client                Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project               Project        @relation(fields: [projectId], references: [id])
  ticketSubType         TicketSubType? @relation(fields: [subTypeId], references: [id])
  ticketType            TicketType?    @relation(fields: [typeId], references: [id])
  audits                TicketAudit[]
}

model Technician {
  id              String   @id @default(cuid())
  employeeId      String?  @unique
  phoneNumber     String?  @unique
  name            String
  specialty       String?
  experienceLevel String?
  supervisorId    String?
  projectId       String?
  idNumber        String?
  idPhotoUrl      String?
  documentUrls    String[] @default([])
  clothingSize    String?
  shoeSize        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project? @relation(fields: [projectId], references: [id])
  supervisor      User?    @relation("SupervisorTechnicians", fields: [supervisorId], references: [uid])
}

model Specialty {
  id             String          @id @default(cuid())
  key            String          @unique
  nameAr         String
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  ticketSubTypes TicketSubType[]
  ticketTypes    TicketType[]
  users          User[]          @relation("UserSpecialties")
}

model TicketType {
  id          String              @id @default(cuid())
  key         String              @unique
  nameAr      String
  description String?
  specialtyId String?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tickets     Ticket[]
  subTypes    TicketSubType[]
  specialty   Specialty?          @relation(fields: [specialtyId], references: [id])
  keywords    TicketTypeKeyword[]
}

model TicketSubType {
  id           String              @id @default(cuid())
  nameAr       String
  description  String?
  parentTypeId String
  specialtyId  String?
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tickets      Ticket[]
  parentType   TicketType          @relation(fields: [parentTypeId], references: [id], onDelete: Cascade)
  specialty    Specialty?          @relation(fields: [specialtyId], references: [id])
  keywords     TicketTypeKeyword[]
}

model TicketTypeKeyword {
  id                String         @id @default(cuid())
  keyword           String
  typeId            String?
  subTypeId         String?
  weight            Float          @default(1.0)
  isLearned         Boolean        @default(false)
  usageCount        Int            @default(0)
  confidence        Float          @default(1.0)
  source            String         @default("seed")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pendingReclassify Boolean        @default(false)
  subType           TicketSubType? @relation(fields: [subTypeId], references: [id], onDelete: Cascade)
  ticketType        TicketType?    @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([keyword, typeId])
  @@unique([keyword, subTypeId])
  @@index([keyword])
  @@index([typeId])
  @@index([subTypeId])
}

model TicketAudit {
  id        String   @id @default(cuid())
  ticketId  String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([changedAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum TicketStatus {
  open
  in_progress
  pending
  completed
  closed
  waiting
  out_of_scope
  absent
}

enum TicketPriority {
  low
  medium
  medium_high
  high
  urgent
}
